@model WebMobileAssignment.Models.ResetPasswordVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    ViewBag.Title = "Account | Reset Password";
}

<div class="account-box">
    <h2>@localizer["Reset Password"]</h2>

    <form method="post" class="form">
        <div asp-validation-summary="ModelOnly"></div>

        <label asp-for="Email">@localizer["Email"]</label>
        <input asp-for="Email" autofocus />
        <span asp-validation-for="Email"></span>

        <section>
            <button>@localizer["Submit"]</button>
            <button type="reset">@localizer["Reset"]</button>
        </section>
    </form>

    <p>
        @localizer["Remembered your password?"] <a href="/Account/Login">@localizer["Back to Login"]</a>
    </p>

</div>