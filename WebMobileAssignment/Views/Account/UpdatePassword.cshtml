@model WebMobileAssignment.Models.UpdatePasswordVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    ViewBag.Title = "Account | Update Password";

    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewBag.AdminProfile = "active";
    }
}
<div class="account-box">
    <h2>@localizer["Change Password"]</h2>

    <form method="post" class="form">
        <div asp-validation-summary="ModelOnly"></div>

        <label asp-for="Current">@localizer["Current"]</label>
        <input asp-for="Current" autofocus />
        <span asp-validation-for="Current"></span>

        <label asp-for="New">@localizer["New"]</label>
        <input asp-for="New" />
        <span asp-validation-for="New"></span>

        <label asp-for="Confirm">@localizer["Confirm"]</label>
        <input asp-for="Confirm" />
        <span asp-validation-for="Confirm"></span>

        <section>
            <button>@localizer["Update"]</button>
            <button type="reset">@localizer["Reset"]</button>
        </section>
    </form>

    <p>
        <a href="/Account/Profile">@localizer["Back to Profile"]</a>
    </p>

</div>