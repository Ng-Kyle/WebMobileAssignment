@model WebMobileAssignment.Models.UpdatePasswordVM

@{
    ViewBag.Title = "Account | Update Password";
}

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Current"></label>
    <input asp-for="Current" autofocus />
    <span asp-validation-for="Current"></span>

    <label asp-for="New"></label>
    <input asp-for="New" />
    <span asp-validation-for="New"></span>

    <label asp-for="Confirm"></label>
    <input asp-for="Confirm" />
    <span asp-validation-for="Confirm"></span>

    <section>
        <button>Update</button>
        <button type="reset">Reset</button>
    </section>
</form>

<p>
    <a href="/Account/Profile">Back to Profile</a>
</p>