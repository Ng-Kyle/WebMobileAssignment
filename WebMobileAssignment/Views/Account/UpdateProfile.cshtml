@model WebMobileAssignment.Models.UpdateProfileVM

@{
    ViewBag.Title = "Account | Update Profile";
}

<form method="post" enctype="multipart/form-data" class="form">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Email"></label>
    <b>@Model?.Email</b>
    <br />

    <label asp-for="UserName"></label>
    <input asp-for="UserName" autofocus />
    <span asp-validation-for="UserName"></span>

    <label asp-for="Photo"></label>
    <label class="upload">
        <input asp-for="Photo" accept="image/jpeg,image/png" hidden />
        <img src="/images/member/@(Model?.ImageLink ?? "photo.jpg")" />
    </label>
    <span asp-validation-for="Photo"></span>

    <section>
        <button>Update</button>
        <button type="reset">Reset</button>
    </section>
</form>

<p>
    <a href="/Account/Profile">Back to Profile</a>
</p>

@section foot {
    <script>
        // Enable client-side validation on hidden file inputs
        $.validator.setDefaults({ ignore: '' });
    </script>
}