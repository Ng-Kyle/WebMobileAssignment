@model WebMobileAssignment.Models.RegisterAdminVM

@{
    Layout = "_AdminLayout";
    ViewBag.AdminListing = "admin_sidenav-active";
    ViewBag.Title = "Register Admin";
}

<div class="admin_card">
    <h1 style="margin-bottom: 1.5rem;">Register Admin</h1>

    <form class="addanime_form" method="post" asp-action="RegisterAdmin" id="adminRegisterForm">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="addanime_input-container">
            <label class="addanime_label" asp-for="Email">Email</label>
            <input asp-for="Email" class="addanime_input-text" autofocus autocomplete="off" style="flex: none; width: 380px;" />
            <span id="email-status" style="font-weight: bold; font-size: 0.85rem; margin-left: 12px;"></span>
            <span asp-validation-for="Email" style="margin-left: 8px;"></span>
        </div>

        <div class="addanime_input-container">
            <label class="addanime_label" asp-for="UserName">Username</label>
            <input asp-for="UserName" class="addanime_input-text" autocomplete="off" style="flex: none; width: 380px;" />
            <span id="username-status" style="font-weight: bold; font-size: 0.85rem; margin-left: 12px;"></span>
            <span asp-validation-for="UserName" style="margin-left: 8px;"></span>
        </div>

        <div class="addanime_input-container">
            <label class="addanime_label" asp-for="Password">Password</label>
            <input asp-for="Password" class="addanime_input-text" type="password" style="flex: none; width: 380px;" />
            <span asp-validation-for="Password" style="margin-left: 12px;"></span>
        </div>

        <div class="addanime_input-container">
            <label class="addanime_label" asp-for="ConfirmPassword">Confirm</label>
            <input asp-for="ConfirmPassword" class="addanime_input-text" type="password" style="flex: none; width: 380px;" />
            <span asp-validation-for="ConfirmPassword" style="margin-left: 12px;"></span>
        </div>

        <div class="addanime_button-area" style="max-width: 510px; margin-top: 1rem;">
            <button type="submit" id="btnSubmitAdmin" class="addanime_button">Register Admin</button>
            <a href="/Admin/Admins" class="addanime_button">Cancel</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        const emailInput = document.getElementById('Email');
        const emailStatus = document.getElementById('email-status');
        const usernameInput = document.getElementById('UserName');
        const usernameStatus = document.getElementById('username-status');
        const submitBtn = document.getElementById('btnSubmitAdmin');

        let isEmailValid = false;
        let isUserValid = false;
        let emailTimer;
        let userTimer;

        function checkFormState() {
            const hasBlocked = emailStatus.style.color === 'rgb(220, 53, 69)' || usernameStatus.style.color === 'rgb(220, 53, 69)';
            submitBtn.disabled = hasBlocked;
            submitBtn.style.opacity = hasBlocked ? "0.5" : "1";
            submitBtn.style.cursor = hasBlocked ? "not-allowed" : "pointer";
        }

        emailInput.addEventListener('input', () => {
            clearTimeout(emailTimer);
            const email = emailInput.value.trim();

            if (!email || !email.includes('@@')) {
                emailStatus.textContent = '';
                checkFormState();
                return;
            }

            emailStatus.style.color = '#6c757d';
            emailStatus.textContent = 'Checking...';

            emailTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/Admin/CheckEmail?email=${encodeURIComponent(email)}`);
                    const data = await res.json();

                    if (data.exists) {
                        emailStatus.style.color = '#dc3545';
                        emailStatus.textContent = data.message;
                    } else {
                        emailStatus.style.color = '#198754';
                        emailStatus.textContent = 'Available';
                    }
                } catch {
                    emailStatus.textContent = '';
                }
                checkFormState();
            }, 400);
        });

        usernameInput.addEventListener('input', () => {
            clearTimeout(userTimer);
            const userName = usernameInput.value.trim();

            if (!userName) {
                usernameStatus.textContent = '';
                checkFormState();
                return;
            }

            usernameStatus.style.color = '#6c757d';
            usernameStatus.textContent = 'Checking...';

            userTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/Admin/CheckUserName?userName=${encodeURIComponent(userName)}`);
                    const data = await res.json();

                    if (data.exists) {
                        usernameStatus.style.color = '#dc3545';
                        usernameStatus.textContent = data.message || 'Already taken';
                    } else {
                        usernameStatus.style.color = '#198754';
                        usernameStatus.textContent = 'Available';
                    }
                } catch {
                    usernameStatus.textContent = '';
                }
                checkFormState();
            }, 400);
        });
    </script>
}