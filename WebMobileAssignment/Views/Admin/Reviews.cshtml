@{
    Layout = "_AdminLayout";
    ViewBag.AdminReviews = "admin_sidenav-active";
    ViewData["Title"] = "Review Maintenance";
}
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@model WebMobileAssignment.Models.AdminReviewIndexVM
@using X.PagedList.Mvc.Core

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --surface: #ffffff;
        --border: #e2e8f0;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --info: #0284c7;
        --info-hover: #0369a1;
        --star-bg: #fffbebe6;
        --star-text: #b45309;
        --star-border: #fde68a;
    }

    .admin-rev-container {
        max-width: 1280px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--text-main);
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: -0.025em;
        margin: 0;
    }

    .page-subtitle {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    /* Filter Card */
    .filter-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .filter-group label {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    .form-control-custom {
        width: 100%;
        padding: 0.625rem 0.875rem;
        font-size: 0.875rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background-color: #fff;
        color: var(--text-main);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        outline: none;
    }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

    .btn-group-filter {
        display: flex;
        gap: 0.5rem;
    }

    .btn-ui {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .btn-ui-primary {
        background-color: var(--primary);
        color: white;
    }

        .btn-ui-primary:hover {
            background-color: var(--primary-hover);
        }

    .btn-ui-secondary {
        background-color: #f1f5f9;
        color: var(--text-muted);
        border: 1px solid var(--border);
    }

        .btn-ui-secondary:hover {
            background-color: #e2e8f0;
            color: var(--text-main);
        }

    /* Data Table Card */
    .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }

    .rev-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .rev-table th {
            background: #f8fafc;
            padding: 0.875rem 1.25rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
        }

        .rev-table td {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            font-size: 0.875rem;
            vertical-align: middle;
        }

        .rev-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .rev-table tbody tr:hover {
                background-color: #f8fafc;
            }

            .rev-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* Badges & Elements */
    .anime-title {
        font-weight: 600;
        color: var(--text-main);
        display: block;
    }

    .user-badge {
        color: var(--text-muted);
        font-weight: 500;
    }

    .badge-star {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background-color: var(--star-bg);
        color: var(--star-text);
        border: 1px solid var(--star-border);
        font-weight: 700;
        font-size: 0.8125rem;
        padding: 0.25rem 0.625rem;
        border-radius: 20px;
    }

    .review-preview {
        color: #334155;
        max-width: 320px;
        line-height: 1.4;
    }

    .date-text {
        color: var(--text-muted);
        font-size: 0.8125rem;
        white-space: nowrap;
    }

    /* Actions */
    .action-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-action-sm {
        padding: 0.4rem 0.75rem;
        font-size: 0.8125rem;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-action-info {
        background-color: #f0f9ff;
        color: var(--info);
        border: 1px solid #bae6fd;
    }

        .btn-action-info:hover {
            background-color: var(--info);
            color: white;
        }

    .btn-action-danger {
        background-color: #fef2f2;
        color: var(--danger);
        border: 1px solid #fecaca;
    }

        .btn-action-danger:hover {
            background-color: var(--danger);
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-muted);
    }

    .pagination-wrapper {
        margin-top: 1.5rem;
        display: flex;
        justify-content: flex-end;
    }
</style>

<div class="admin-rev-container">
    <div class="page-header">
        <h1 class="page-title">@localizer["Review Maintenance"]</h1>
        <p class="page-subtitle">@localizer["Search, filter, inspect, and moderate user reviews and ratings."]</p>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <form method="get" asp-action="Reviews" class="filter-grid">
            <div class="filter-group">
                <label>@localizer["Search Keyword"]</label>
                <input type="text" name="search" value="@Model?.Search" class="form-control-custom" placeholder="@localizer["Review text or username..."]" />
            </div>
            <div class="filter-group">
                <label>@localizer["Filter Rating"]</label>
                <select name="rating" class="form-control-custom">
                    <option value="">@localizer["All Ratings"]</option>
                    @for (int i = 10; i >= 1; i--)
                    {
                        <option value="@i" selected="@(Model?.SelectedRating == i)">★ @i @localizer["Stars"]</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>@localizer["Filter Anime"]</label>
                <select name="animeId" asp-items="ViewBag.AnimeList" class="form-control-custom">
                    <option value="">@localizer["All Anime"]</option>
                </select>
            </div>
            <div class="btn-group-filter">
                <button type="submit" class="btn-ui btn-ui-primary">@localizer["Filter"]</button>
                <a asp-action="Reviews" class="btn-ui btn-ui-secondary">@localizer["Reset"]</a>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="table-card">
        <table class="rev-table">
            <thead>
                <tr>
                    <th>@localizer["Anime"]</th>
                    <th>@localizer["User"]</th>
                    <th>@localizer["Rating"]</th>
                    <th>@localizer["Review Content"]</th>
                    <th>@localizer["Date"]</th>
                    <th style="text-align: right;">@localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <tr>
                            <td><span class="anime-title">@(review.Anime?.Name ?? "N/A")</span></td>
                            <td><span class="user-badge">@@@(review.Member?.UserName ?? "Anonymous")</span></td>
                            <td>
                                <span class="badge-star">★ @review.Rating / 10</span>
                            </td>
                            <td>
                                <div class="review-preview">
                                    @if (!string.IsNullOrWhiteSpace(review.Text))
                                    {
                                        @(review.Text.Length > 65 ? review.Text.Substring(0, 65) + "..." : review.Text)
                                    }
                                    else
                                    {
                                        <em style="color: #94a3b8;">@localizer["No text provided"]</em>
                                    }
                                </div>
                            </td>
                            <td><span class="date-text">@review.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                            <td>
                                <div class="action-group" style="justify-content: flex-end;">
                                    <a asp-action="ReviewDetails" asp-route-id="@review.ReviewId" class="btn-action-sm btn-action-info">@localizer["Details"]</a>
                                    <form method="post" asp-action="DeleteReview" onsubmit="return confirm('@localizer["Are you sure you want to delete this review?"]');" style="margin: 0;">
                                        <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                        <button type="submit" class="btn-action-sm btn-action-danger">@localizer["Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <strong>@localizer["No reviews match your criteria."]</strong>
                                <p style="margin-top: 0.25rem; font-size: 0.875rem;">@localizer["Try adjusting your filters or search term."]</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model?.Reviews != null && Model.Reviews.Any())
    {
        <div class="pagination-wrapper">
            @Html.PagedListPager(Model.Reviews, page => Url.Action("Reviews", new { page, search = Model.Search, rating = Model.SelectedRating, animeId = Model.SelectedAnimeId }))
        </div>
    }
</div>