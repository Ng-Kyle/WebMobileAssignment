@{
    Layout = "_AdminLayout";
    ViewBag.AdminHome = "admin_sidenav-active";
    ViewData["Title"] = "Review Maintenance";
}

@model WebMobileAssignment.Models.AdminReviewIndexVM
@using X.PagedList.Mvc.Core

<div class="admin-rev-container">
    <div class="page-header">
        <h1 class="page-title">Review Maintenance</h1>
        <p class="page-subtitle">Search, filter, inspect, and moderate user reviews and ratings.</p>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <form method="get" asp-action="Reviews" class="filter-grid">
            <div class="filter-group">
                <label>Search Keyword</label>
                <input type="text" name="search" value="@Model?.Search" class="form-control-custom" placeholder="Review text or username..." />
            </div>
            <div class="filter-group">
                <label>Filter Rating</label>
                <select name="rating" class="form-control-custom">
                    <option value="">All Ratings</option>
                    @for (int i = 10; i >= 1; i--)
                    {
                        <option value="@i" selected="@(Model?.SelectedRating == i)">★ @i Stars</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Filter Anime</label>
                <select name="animeId" asp-items="ViewBag.AnimeList" class="form-control-custom">
                    <option value="">All Anime</option>
                </select>
            </div>
            <div class="btn-group-filter">
                <button type="submit" class="btn-ui btn-ui-primary">Filter</button>
                <a asp-action="Reviews" class="btn-ui btn-ui-secondary">Reset</a>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="table-card">
        <table class="rev-table">
            <thead>
                <tr>
                    <th>Anime</th>
                    <th>User</th>
                    <th>Rating</th>
                    <th>Review Content</th>
                    <th>Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <tr>
                            <td><span class="anime-title">@(review.Anime?.Name ?? "N/A")</span></td>
                            <td><span class="user-badge">@@@(review.Member?.UserName ?? "Anonymous")</span></td>
                            <td>
                                <span class="badge-star">★ @review.Rating / 10</span>
                            </td>
                            <td>
                                <div class="review-preview">
                                    @if (!string.IsNullOrWhiteSpace(review.Text))
                                    {
                                        @(review.Text.Length > 65 ? review.Text.Substring(0, 65) + "..." : review.Text)
                                    }
                                    else
                                    {
                                        <em style="color: #94a3b8;">No text provided</em>
                                    }
                                </div>
                            </td>
                            <td><span class="date-text">@review.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                            <td>
                                <div class="action-group" style="justify-content: flex-end;">
                                    <a asp-action="ReviewDetails" asp-route-id="@review.ReviewId" class="btn-action-sm btn-action-info">Details</a>
                                    <form method="post" asp-action="DeleteReview" onsubmit="return confirm('Are you sure you want to delete this review?');" style="margin: 0;">
                                        <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                        <button type="submit" class="btn-action-sm btn-action-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <strong>No reviews match your criteria.</strong>
                                <p style="margin-top: 0.25rem; font-size: 0.875rem;">Try adjusting your filters or search term.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model?.Reviews != null && Model.Reviews.Any())
    {
        <div class="pagination-wrapper">
            @Html.PagedListPager(Model.Reviews, page => Url.Action("Reviews", new { page, search = Model.Search, rating = Model.SelectedRating, animeId = Model.SelectedAnimeId }))
        </div>
    }
</div>