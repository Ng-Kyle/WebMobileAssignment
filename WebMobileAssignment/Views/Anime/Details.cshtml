@model WebMobileAssignment.Models.Anime

@{
    Layout = "_MemberLayout";

    string ResolveImagePath(string? link)
    {
        if (string.IsNullOrWhiteSpace(link))
            return "/images/frieren.jpg";
        if (link.StartsWith("http") || link.StartsWith("/"))
            return link;
        if (link.Contains("/"))
            return "/" + link;
        return "/images/anime/" + link;
    }

    var rawMain = Model.AnimeImages?.FirstOrDefault(i => i.IsThumbnail)?.ImageLink
               ?? Model.AnimeImages?.FirstOrDefault()?.ImageLink;

    var mainImage = ResolveImagePath(rawMain);

    var avgScore = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating).ToString("0.0")
        : "N/A";
}

@section Styles {
    <link rel="stylesheet" href="~/css/anime-catalogue.css" asp-append-version="true" />
}

<div class="productDetailsProductContent">
    <div class="productDetailsProductImgContainer">
        <div class="productDetailsImgView">
            <img id="productDetailsDisplayIMG" src="@mainImage" asp-append-version="true" alt="@Model.Name">
        </div>

        @if (Model.AnimeImages != null && Model.AnimeImages.Count > 1)
        {
            <div class="productDetailsThumbnailBar">
                <div class="productDetailsThumbnailInner">
                    @foreach (var img in Model.AnimeImages)
                    {
                        var thumbPath = ResolveImagePath(img.ImageLink);
                        <img class="productDetailsThumbIMG"
                             src="@thumbPath"
                             asp-append-version="true"
                             alt="Thumbnail"
                             onclick="swapImage('@thumbPath', this)" />
                    }
                </div>
            </div>
        }
    </div>

    <div class="productDetailsProductDetails">
        <div class="animeHeader">
            <h2>@Model.Name</h2>
            <div class="productDetailsPrice">⭐ @avgScore <span class="scoreLabel">/ 10</span></div>
        </div>

        <div class="animeGenreBadges">
            @if (Model.Genres != null && Model.Genres.Any())
            {
                @foreach (var genre in Model.Genres)
                {
                    <span class="genreBadge">@genre.Name</span>
                }
            }
            else
            {
                <span class="genreBadge">General</span>
            }
        </div>

        <div class="animeMetaGrid">
            <div class="metaItem">
                <span class="metaKey">Studio:</span>
                <span class="metaVal">@(Model.Studio?.Name ?? "Unknown")</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">Episodes:</span>
                <span class="metaVal">@Model.Episodes</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">Status:</span>
                <span class="metaVal">@Model.Status</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">Release Date:</span>
                <span class="metaVal">@(Model.ReleaseDate?.ToString("MMM dd, yyyy") ?? "TBA")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.TrailerLink))
            {
                <div class="metaItem metaItemFull">
                    <span class="metaKey">Trailer:</span>
                    <span class="metaVal">
                        <a href="@Model.TrailerLink" target="_blank" class="trailerLink">Watch on YouTube ↗</a>
                    </span>
                </div>
            }
        </div>

        <div class="productDetailsDescriptionBox">
            <h3>Synopsis</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Synopsis) ? "No synopsis has been provided for this title yet." : Model.Synopsis)</p>
        </div>

        <div class="watchlistActionBox">
            <h4>Update Watchlist</h4>
            <form method="post" class="productDetailsAddCartButton">
                <input type="hidden" name="AnimeId" value="@Model.AnimeId" />

                <div class="formRowGroup">
                    <div class="productDetailsQuantityInput">
                        <label>Status:</label>
                        <select name="status">
                            <option value="Watching">Watching</option>
                            <option value="Completed">Completed</option>
                            <option value="Plan to Watch">Plan to Watch</option>
                            <option value="On-Hold">On-Hold</option>
                            <option value="Dropped">Dropped</option>
                        </select>
                    </div>

                    <div class="productDetailsQuantityInput">
                        <label>Progress:</label>
                        <input type="number" name="progress" min="0" max="@Model.Episodes" value="0" />
                        <span>/ @Model.Episodes eps</span>
                    </div>
                </div>

                <button type="button" class="productDetailsBtn">+ Save to Watchlist</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function swapImage(imgSrc, element) {
            const mainImg = document.getElementById('productDetailsDisplayIMG');
            if (mainImg) {
                mainImg.src = imgSrc;
            }
        }
    </script>
}