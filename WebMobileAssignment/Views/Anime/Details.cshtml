@model WebMobileAssignment.Models.Anime
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    Layout = "_Layout";

    string ResolveImagePath(string? link)
    {
        if (string.IsNullOrWhiteSpace(link))
            return "/images/photo.jpg";
        if (link.StartsWith("http") || link.StartsWith("/"))
            return link;
        if (link.Contains("/"))
            return "/" + link;
        return "/images/anime/" + link;
    }

    var rawMain = Model.AnimeImages?.FirstOrDefault(i => i.IsThumbnail)?.ImageLink
               ?? Model.AnimeImages?.FirstOrDefault()?.ImageLink;

    var mainImage = ResolveImagePath(rawMain);

    var avgScore = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating).ToString("0.0")
        : "N/A";
}


<div class="productDetailsProductContent">
    <div class="productDetailsProductImgContainer">
        <div class="productDetailsImgView">
            <img id="productDetailsDisplayIMG" src="@mainImage" asp-append-version="true" alt="@Model.Name">
        </div>

        @if (Model.AnimeImages != null && Model.AnimeImages.Count > 1)
        {
            <div class="productDetailsThumbnailBar">
                <div class="productDetailsThumbnailInner">
                    @foreach (var img in Model.AnimeImages)
                    {
                        var thumbPath = ResolveImagePath(img.ImageLink);
                        <img class="productDetailsThumbIMG"
                             src="@thumbPath"
                             asp-append-version="true"
                             alt="Thumbnail"
                             onclick="swapImage('@thumbPath', this)" />
                    }
                </div>
            </div>
        }
    </div>

    <div class="productDetailsProductDetails">
        <div class="animeHeader">
            <h2>@Model.Name</h2>
            <div class="productDetailsPrice">⭐ @avgScore <span class="scoreLabel">/ 10</span></div>
        </div>

        <div class="animeGenreBadges">
            @if (Model.Genres != null && Model.Genres.Any())
            {
                @foreach (var genre in Model.Genres)
                {
                    <span class="genreBadge">@genre.Name</span>
                }
            }
            else
            {
                <span class="genreBadge">@localizer["General"]</span>
            }
        </div>

        <div class="animeMetaGrid">
            <div class="metaItem">
                <span class="metaKey">@localizer["Studio"]:</span>
                <span class="metaVal">@(Model.Studio?.Name ?? "Unknown")</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">@localizer["Episodes"]:</span>
                <span class="metaVal">@Model.Episodes</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">@localizer["Status"]:</span>
                <span class="metaVal">@Model.Status</span>
            </div>
            <div class="metaItem">
                <span class="metaKey">@localizer["Release Date"]:</span>
                <span class="metaVal">@(Model.ReleaseDate?.ToString("MMM dd, yyyy") ?? localizer["TBA"].Value)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.TrailerLink))
            {
                <div class="metaItem metaItemFull">
                    <span class="metaKey">@localizer["Trailer"]:</span>
                    <span class="metaVal">
                        <a href="@Model.TrailerLink" target="_blank" class="trailerLink">@localizer["Watch on YouTube"] ↗</a>
                    </span>
                </div>
            }
        </div>

        <div class="productDetailsDescriptionBox">
            <h3>@localizer["Synopsis"]</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Synopsis) ? localizer["No synopsis has been provided for this title yet."] : Model.Synopsis)</p>
        </div>

            @{
                bool isUnreleased = Model.Status?.Equals("Not Yet Aired", StringComparison.OrdinalIgnoreCase) == true
                || Model.Status?.Equals("Unreleased", StringComparison.OrdinalIgnoreCase) == true
                || (Model.ReleaseDate.HasValue && Model.ReleaseDate.Value > DateOnly.FromDateTime(DateTime.Today));
            }

        <div class="watchlistActionBox">
            <h4>@localizer["Update Watchlist"]</h4>
            <form method="post" class="productDetailsAddCartButton">
                <input type="hidden" name="AnimeId" value="@Model.AnimeId" />

                <div class="formRowGroup">
                    <div class="productDetailsQuantityInput">
                        <label>@localizer["Status"]:</label>
                        <select name="status" id="watchlistStatus" onchange="handleStatusChange()">
                            @if (isUnreleased)
                            {
                                <option value="Plan to Watch" selected>Plan to Watch</option>
                            }
                            else
                            {
                             <option value="Watching">@localizer["Watching"]</option>
                             <option value="Completed">@localizer["Completed"]</option>
                             <option value="Plan to Watch">@localizer["Plan to Watch"]</option>
                             <option value="On-Hold">@localizer["On-Hold"]</option>
                             <option value="Dropped">@localizer["Dropped"]</option>
                            }
                        </select>
                    </div>

                    <div class="productDetailsQuantityInput">
                        <label>@localizer["Progress"]:</label>
                        <input type="number" name="progress" id="watchlistProgress" min="0" max="@Model.Episodes" value="0" />
                        <span>/ @Model.Episodes @localizer["eps"]</span>
                    </div>
                </div>

                <button type="button" class="productDetailsBtn">+ @localizer["Save to Watchlist"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function swapImage(imgSrc, element) {
            const mainImg = document.getElementById('productDetailsDisplayIMG');
            if (mainImg) {
                mainImg.src = imgSrc;
            }
        }

        function handleStatusChange() {
            const statusSelect = document.getElementById('watchlistStatus');
            const progressInput = document.getElementById('watchlistProgress');

            if (!statusSelect || !progressInput) return;

            if (statusSelect.value === "Plan to Watch") {
                progressInput.value = 0;
                progressInput.disabled = true;
                progressInput.style.backgroundColor = "#e0e0e0";
                progressInput.style.cursor = "not-allowed";
            } else {
                progressInput.disabled = false;
                progressInput.style.backgroundColor = "#FFF4ED";
                progressInput.style.cursor = "auto";
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            handleStatusChange();
        });
    </script>
}