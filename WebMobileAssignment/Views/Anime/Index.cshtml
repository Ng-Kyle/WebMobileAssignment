@model IEnumerable<WebMobileAssignment.Models.Anime>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    Layout = "_Layout";
    var genreIds = (List<int>)(ViewBag.SelectedGenreIds ?? new List<int>());
    int? selectedStudioId = ViewBag.SelectedStudioId;   
}


<div class="productListSearchBar">
    <form data-ajax="true" data-ajax-update="#target" data-ajax-loading="loader" id="f" method="get" asp-controller="Anime" asp-action="Index">
        @Html.TextBox("search", (string)ViewBag.Search, new { @class = "admin_searchbar", type = "search", autofocus = "", data_trim = "", placeholder = localizer["Search anime titles..."].Value })
        <img src="/images/loader.gif" id="loader" style="display: none; vertical-align: middle; height: 30px;" />
    </form>
</div>

<div class="search-container">
    <aside class="productListSidebar productListFilter">
            <div class="productListFilterContainer">
                <h3>@localizer["Filter by Studio"]</h3>
                <div class="productListFilterGroup">
                    <label>
                        <input type="radio"
                               form="f"
                               name="studioId"
                               value=""
                        @(selectedStudioId == null ? "checked" : "") />
                        @localizer["All Studios"]
                    </label>
                    @if (ViewBag.Studios != null)
                    {
                        @foreach (var s in (List<WebMobileAssignment.Models.Studio>)ViewBag.Studios)
                        {
                            <label>
                                <input type="radio"
                                       form="f" 
                                       name="studioId"
                                       value="@s.StudioId"
                                        @(selectedStudioId == s.StudioId ? "checked" : "") onchange="$('#f').submit()" />
                                @s.Name
                            </label>
                        }
                    }
                </div>

                <h3>@localizer["Filter by Genre"]</h3>
                <div class="productListFilterGroup">
                    @if (ViewBag.Genres != null)
                    {
                        @foreach (var g in (List<WebMobileAssignment.Models.Genre>)ViewBag.Genres)
                        {
                            <label>
                                <input type="checkbox"
                                       form="f"
                                       name="genreIds"
                                       value="@g.GenreId"
                                       @(genreIds.Contains(g.GenreId) ? "checked" : "") onchange="$('#f').submit()" />
                                @g.Name
                            </label>
                        }
                    }
                </div>

                <h3>@localizer["Filter by Episodes"]</h3>
                <div class="productListFilterGroup">
                    <input type="number"
                           form="f"
                           name="min"
                           value="@ViewBag.Min"
                           placeholder="@localizer["Min"]"
                           min="1" />
                    <input type="number"
                           form="f" 
                           name="max"
                           value="@ViewBag.Max"
                           placeholder="@localizer["Max"]"
                           min="1" />
                </div>
            </div>

            
            <a asp-controller="Anime" asp-action="Index">@localizer["Clear All"]</a>
    </aside>

    <div class="productListContent" id="target">
           <partial name="_AnimeGrid" model="Model" />        
    </div>
</div>


@section foot {
    <script>
        let timer = null;

        $('#search, #minEpisodes, #maxEpisodes').on('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => $('#f').submit(), 500);
        });
    </script>
}