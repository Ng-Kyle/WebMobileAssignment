@model IEnumerable<WebMobileAssignment.Models.Anime>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    Layout = "_Layout";
    var genreIds = (List<int>)(ViewBag.SelectedGenreIds ?? new List<int>());
    int? selectedStudioId = ViewBag.SelectedStudioId;   
}


<div class="productListSearchBar">
    <form method="get" asp-controller="Anime" asp-action="Index">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="@localizer["Search anime titles..."]" />
    </form>
</div>

<div class="search-container">
    <aside class="productListSidebar">
        <form class="productListFilter" method="get" asp-controller="Anime" asp-action="Index">
            <input type="hidden" name="search" value="@ViewBag.Search" />

            <div class="productListFilterContainer">
                <h3>@localizer["Filter by Studio"]</h3>
                <div class="productListFilterGroup">
                    <label>
                        <input type="radio"
                               name="studioId"
                               value=""
                        @(selectedStudioId == null ? "checked" : "") />
                        @localizer["All Studios"]
                    </label>
                    @if (ViewBag.Studios != null)
                    {
                        @foreach (var s in (List<WebMobileAssignment.Models.Studio>)ViewBag.Studios)
                        {
                            <label>
                                <input type="radio"
                                       name="studioId"
                                       value="@s.StudioId"
                                @(selectedStudioId == s.StudioId ? "checked" : "") />
                                @s.Name
                            </label>
                        }
                    }
                </div>

                <h3>@localizer["Filter by Genre"]</h3>
                <div class="productListFilterGroup">
                    @if (ViewBag.Genres != null)
                    {
                        @foreach (var g in (List<WebMobileAssignment.Models.Genre>)ViewBag.Genres)
                        {
                            <label>
                                <input type="checkbox"
                                       name="genreIds"
                                       value="@g.GenreId"
                                @(genreIds.Contains(g.GenreId) ? "checked" : "") />
                                @g.Name
                            </label>
                        }
                    }
                </div>

                <h3>@localizer["Filter by Episodes"]</h3>
                <div class="productListFilterGroup">
                    <input type="number"
                           name="min"
                           value="@ViewBag.Min"
                           placeholder="@localizer["Min"]"
                           min="1" />
                    <input type="number"
                           name="max"
                           value="@ViewBag.Max"
                           placeholder="@localizer["Max"]"
                           min="1" />
                </div>
            </div>

            <button type="submit">@localizer["Apply Filters"]</button>
            <a asp-controller="Anime" asp-action="Index">@localizer["Clear All"]</a>
        </form>
    </aside>

    <div class="productListContent">
        <h1>@localizer["All Anime"] (@Model.Count())</h1>

        @if (!Model.Any())
        {
            <div style="padding: 2rem; font-weight: bold; color: #555;">
                @localizer["No anime matched your search/filter criteria."]
            </div>
        }
        else
        {
            <div class="productListProductsSide">
                @foreach (var item in Model)
                {
                    var rawLink = item.AnimeImages?.FirstOrDefault(i => i.IsThumbnail)?.ImageLink
               ?? item.AnimeImages?.FirstOrDefault()?.ImageLink;

                    string resolvedPath;

                    if (string.IsNullOrWhiteSpace(rawLink))
                    {
                        resolvedPath = "/images/photo.jpg";
                    }
                    else if (rawLink.StartsWith("http") || rawLink.StartsWith("/"))
                    {
                        resolvedPath = rawLink;
                    }
                    else if (rawLink.Contains("/"))
                    {
                        resolvedPath = "/" + rawLink;
                    }
                    else
                    {
                        resolvedPath = "/images/anime/" + rawLink;
                    }

                    var avgScore = item.Reviews != null && item.Reviews.Any()
                        ? item.Reviews.Average(r => r.Rating).ToString("0.0")
                        : "N/A";

                    <div class="productListProductsCard">
                        <a asp-action="Details" asp-route-id="@item.AnimeId">
                            <img src="@resolvedPath" asp-append-version="true" alt="@item.Name" />
                            <h3>@item.Name</h3>
                            <p class="price">@localizer["Score"]: ⭐ @avgScore</p>
                        </a>
                        <div class="buttonGroup">
                            <button type="button" class="productListQuickAdd">+ @localizer["Watchlist"]</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>