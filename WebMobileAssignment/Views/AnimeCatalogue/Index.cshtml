@model IEnumerable<WebMobileAssignment.Models.AnimeCardViewModel>

@section Styles {
    <link rel="stylesheet" href="~/css/anime-catalogue.css" asp-append-version="true" />
}

<div class="productListSearchBar">
    <form method="get">
        <input type="text" name="name" placeholder="Search anime titles..." />
    </form>
</div>

<div class="search-container" style="display: flex;">
    <aside class="productListSidebar">
        <form class="productListFilter" method="get">
            <div class="productListFilterContainer">
                <h3>Filter by Studio</h3>
                <div class="productListFilterGroup">
                    <label><input type="checkbox" name="studio" value="Madhouse" /> Madhouse</label>
                    <label><input type="checkbox" name="studio" value="MAPPA" /> MAPPA</label>
                </div>

                <h3>Filter by Episodes</h3>
                <div class="productListFilterGroup">
                    <input type="number" name="min" placeholder="Min" />
                    <input type="number" name="max" placeholder="Max" />
                </div>
            </div>

            <button type="submit">Apply Filters</button>
            <a asp-action="Index">Clear All</a>
        </form>
    </aside>

    <div class="productListContent">
        <h1>All Anime</h1>
        <div class="productListProductsSide">
            @foreach (var item in Model)
            {
                <div class="productListProductsCard">
                    <a asp-controller="AnimeCatalogue" asp-action="Details" asp-route-id="@item.animeId">
                        <img src="@item.ImageUrl" asp-append-version="true" alt="@item.Title" />
                        <h3>@item.Title</h3>
                        <p class="price">Score: @item.Score.ToString("0.0")</p>
                    </a>
                    <div class="buttonGroup">
                        <button type="button" class="productListQuickAdd">+ Watchlist</button>
                        <button type="button" class="productListWishlist">❤️</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>