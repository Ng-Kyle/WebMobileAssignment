@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Member>

@{
    string[] fields = ["UserName","Email","Animes in Watchlist","Reviews Written", "Account Status"];
}

@Html.Hidden("sort", "", new { form = "f" })
@Html.Hidden("direction", "", new { form = "f" })


<table class="anime_table">
    <thead>
        <tr>
            @foreach (var f in fields)
            {
                string d = "asc";
                string c = "";

                if (f == ViewBag.Sort)
                {
                    d = ViewBag.Direction == "des" ? "asc" : "des";
                    c = ViewBag.Direction;
                }

                <th>
                    <a data-ajax="true"
                       data-ajax-update="#target"
                       data-ajax-loading="#loader"
                       href="?name=@ViewBag.Name&sort=@f&direction=@d" class="@c">@localizer[f]</a>
                </th>
            }
            <th class="anime_blank"></th>
        </tr>
    </thead>
    @if (Model.Count() > 0)
    {
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.UserName</td>   
                <td>@member.Email</td>
                <td>@member.WatchList.AnimeWatchLists.Count</td>
                <td>@member.Reviews.Count</td>
                <td>@((member.IsBlocked) ? localizer["Blocked"] : localizer["Active"])</td>
                <td class="anime_table-buttons-td">
                    <div class="anime_table-buttons">
                        <a class="anime_table-details" asp-controller="Member" asp-action="ManagementDetails" asp-route-userId="@member.UserId">@localizer["Details"]</a>
                        @if (member.IsBlocked)
                        {
                            <a class="anime_table-delete" data-post="/Member/Unblock?userId=@member.UserId">@localizer["Unblock"]</a>
                        }
                        else
                        {
                            <a class="anime_table-delete" data-post="/Member/Block?userId=@member.UserId">@localizer["Block"]</a>
                        }
                    </div>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td class="anime_empty" colspan="6">@localizer["There were no members found."]</td>
        </tr>
    }
</table>

<p>
    @Model.Count() @localizer["of"] @Model.TotalItemCount @localizer["record(s)"] |
    @localizer["Page"] @Model.PageNumber @localizer["of"] @Model.PageCount |
</p>

@{
    var options = PagedListRenderOptions.ClassicPlusFirstAndLast;
    options.LinkToFirstPageFormat = localizer["First"].Value;
    options.LinkToLastPageFormat = localizer["Last"].Value;
    options.LinkToPreviousPageFormat = localizer["Previous"].Value;
    options.LinkToNextPageFormat = localizer["Next"].Value;

    var ajaxOptions = new AjaxOptions
    {
        HttpMethod = "get",
        UpdateTargetId = "target",
        LoadingElementId = "#loader",
    };
}

@Html.PagedListPager(
    Model,
    p => $"?name={ViewBag.Name}&sort={ViewBag.Sort}&direction={ViewBag.Direction}&page={p}",
    PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions)
)
