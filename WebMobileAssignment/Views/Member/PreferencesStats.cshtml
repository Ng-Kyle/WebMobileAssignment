@model WebMobileAssignment.Models.PreferencesStatsVM

@{
    ViewData["Title"] = "Genre & Studio Preferences";
}

<div class="pref-container">
    <h2 class="pref-title">Genre & Studio Preferences</h2>

    <div class="pref-grid">
        <!-- TOP GENRES -->
        <div class="pref-card">
            <div class="pref-card-header">Top 5 Favorite Genres</div>
            @if (Model.TopGenres.Any())
            {
                <ul class="pref-list">
                    @foreach (var genre in Model.TopGenres)
                    {
                        <li class="pref-item">
                            <span class="pref-name">@genre.Name</span>
                            <div class="pref-details">
                                <span class="pref-pill">@genre.Count watched</span>
                                <span class="pref-rating">★ @genre.AverageRating.ToString("0.0")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-msg">No genre preference data available yet.</div>
            }
        </div>

        <!-- TOP STUDIOS -->
        <div class="pref-card">
            <div class="pref-card-header">Top 5 Favorite Studios</div>
            @if (Model.TopStudios.Any())
            {
                <ul class="pref-list">
                    @foreach (var studio in Model.TopStudios)
                    {
                        <li class="pref-item">
                            <span class="pref-name">@studio.Name</span>
                            <div class="pref-details">
                                <span class="pref-pill">@studio.Count watched</span>
                                <span class="pref-rating">★ @studio.AverageRating.ToString("0.0")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-msg">No studio preference data available yet.</div>
            }
        </div>
    </div>
</div>