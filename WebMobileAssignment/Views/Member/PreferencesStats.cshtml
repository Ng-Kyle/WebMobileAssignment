@model WebMobileAssignment.Models.PreferencesStatsVM

@{
    ViewData["Title"] = "Genre & Studio Preferences";
}
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer

<div class="pref-container">
    <h2 class="pref-title">@localizer["Genre & Studio Preferences"]</h2>

    <div class="pref-grid">
        <!-- TOP GENRES -->
        <div class="pref-card">
            <div class="pref-card-header">@localizer["Top 5 Favorite Genres"]</div>
            @if (Model.TopGenres.Any())
            {
                <ul class="pref-list">
                    @foreach (var genre in Model.TopGenres)
                    {
                        <li class="pref-item">
                            <span class="pref-name">@genre.Name</span>
                            <div class="pref-details">
                                <span class="pref-pill">@genre.Count @localizer["watched"]</span>
                                <span class="pref-rating">★ @genre.AverageRating.ToString("0.0")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-msg">@localizer["No genre preference data available yet."]</div>
            }
        </div>

        <!-- TOP STUDIOS -->
        <div class="pref-card">
            <div class="pref-card-header">@localizer["Top 5 Favorite Studios"]</div>
            @if (Model.TopStudios.Any())
            {
                <ul class="pref-list">
                    @foreach (var studio in Model.TopStudios)
                    {
                        <li class="pref-item">
                            <span class="pref-name">@studio.Name</span>
                            <div class="pref-details">
                                <span class="pref-pill">@studio.Count @localizer["watched"]</span>
                                <span class="pref-rating">★ @studio.AverageRating.ToString("0.0")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-msg">@localizer["No studio preference data available yet."]</div>
            }
        </div>
    </div>
</div>