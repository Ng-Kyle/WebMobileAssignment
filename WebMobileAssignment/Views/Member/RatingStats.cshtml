@model WebMobileAssignment.Models.RatingStatsVM

@{
    ViewData["Title"] = "Rating Statistics";
}

<div class="rating-container">
    <h2 class="rating-title">@localizer["Rating Statistics"]</h2>

    <!-- Side-by-Side Main Grid -->
    <div class="rating-dashboard-grid">

        <!-- LEFT COLUMN: Metrics Stack -->
        <div class="rating-summary-stack">
            <div class="rating-card card-border-warning">
                <span class="rating-card-label">@localizer["Mean Score"]</span>
                <p class="rating-card-value text-warning">★ @Model.AverageRating</p>
            </div>
            <div class="rating-card card-border-primary">
                <span class="rating-card-label">@localizer["Total Reviews"]</span>
                <p class="rating-card-value text-primary">@Model.TotalReviewsCount</p>
            </div>
            <div class="rating-card card-border-success">
                <span class="rating-card-label">@localizer["Highest Score"]</span>
                <p class="rating-card-value text-success">@Model.HighestRating / 10</p>
            </div>
            <div class="rating-card card-border-danger">
                <span class="rating-card-label">@localizer["Lowest Score"]</span>
                <p class="rating-card-value text-danger">@Model.LowestRating / 10</p>
            </div>
        </div>

        <!-- RIGHT COLUMN: Score Distribution -->
        <div class="rating-section-card">
            <div class="rating-section-header">@localizer["Score Breakdown (1 to 10 Stars)"]</div>
            <div class="rating-section-body">
                <table class="distribution-table">
                    <tbody>
                        @foreach (var entry in Model.RatingDistribution.OrderByDescending(x => x.Key))
                        {
                            double percentage = Model.TotalReviewsCount > 0
                                ? ((double)entry.Value / Model.TotalReviewsCount) * 100
                                : 0;
                            <tr>
                                <td class="score-label">★ @entry.Key</td>
                                <td>
                                    <div class="bar-wrapper">
                                        <div class="bar-fill" style="width: @percentage%"></div>
                                    </div>
                                </td>
                                <td class="score-count">@entry.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- FULL WIDTH BOTTOM: Top Rated Written Reviews -->
    @if (Model.TopRatedReviews.Any())
    {
        <div class="rating-section-card top-reviews-wrapper">
            <div class="rating-section-header">@localizer["Top Rated Reviews"]</div>
            <ul class="review-list">
                @foreach (var review in Model.TopRatedReviews)
                {
                    <li class="review-item">
                        <div>
                            <h4 class="review-anime-title">@review.Anime?.Name</h4>
                            <p class="review-text">@review.Text</p>
                        </div>
                        <span class="rating-badge">★ @review.Rating / 10</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>