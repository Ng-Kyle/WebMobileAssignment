@inject DB db
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AnonAnimeList</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="member_body">
    <div class="info">@Html.Raw(TempData["Info"])</div>

    <header>
        <nav class="admin_topnav member_topnav">
            <div class="admin_topnav-home">
                <a asp-controller="Anime" asp-action="Index">
                    <img class="admin_topnav-icon" src="/images/favicon.png" alt="Logo" />AnonAnimeList
                </a>
            </div>

            <div class="member_nav_links">
                <a asp-controller="Anime" asp-action="Index">@localizer["anime_side"]</a>
                <a asp-controller="Studio" asp-action="Index">@localizer["studio_side"]</a>
                <a asp-controller="Watchlist" asp-action="Index">@localizer["My Watchlist"]</a>
                <a asp-controller="Member" asp-action="ProgressStats">@localizer["Progress Stats"]</a>
            </div>

            <div class="admin_topnav-end">
                <a asp-controller="Language" asp-action="Index" asp-route-culture="ja">日本語</a>
                <a asp-controller="Language" asp-action="Index" asp-route-culture="en">English</a>
                <a asp-controller="Account" asp-action="Logout">@localizer["logout"]</a>
            </div>
        </nav>
    </header>

    <main class="member_main">
        @RenderBody()
    </main>

    <footer class="admin_footer">
        <div class="copyright">
            <p>@localizer["copyright"] &copy; 2026. AnonAnimeList</p>
        </div>
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)
    @RenderSection("Scripts", false)
</body>
</html>