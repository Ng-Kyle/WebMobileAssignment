@inject DB db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "AnonAnimeList")</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
    @RenderSection("Styles", false)
</head>
<body class="member_body">
    <div class="info">@Html.Raw(TempData["Info"])</div>

    <header>
        <nav class="admin_topnav member_topnav">
            <div class="admin_topnav-home">
                <a asp-controller="Anime" asp-action="Index">
                    <img class="admin_topnav-icon" src="/images/favicon.png" alt="Logo" />AnonAnimeList
                </a>
            </div>

            <div class="member_nav-links">
                <a asp-controller="Anime" asp-action="Index">Anime</a>
                <a asp-controller="Studio" asp-action="Index">Studios</a>
                <a asp-controller="Watchlist" asp-action="Index">My Watchlist</a>
            </div>

            <div class="member_nav-auth">
                <a asp-controller="Admin" asp-action="Index">Admin Area</a>
            </div>
        </nav>
    </header>

    <main class="member_main">
        @RenderBody()
    </main>

    <footer class="admin_footer">
        <div class="copyright">
            <p>All Rights Reserved &copy; 2026. AnonAnimeList</p>
        </div>
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)
    @RenderSection("Scripts", false)
</body>
</html> 