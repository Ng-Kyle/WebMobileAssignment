@model IEnumerable<WebMobileAssignment.Models.Studio>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer

@{
    Layout = "_Layout";
    string currentSort = ViewBag.Sort as string ?? "name_asc";
}

<form data-ajax="true" data-ajax-update="#target" data-ajax-loading="#loader" id="f" method="get" asp-controller="Studio" asp-action="Index">
    <div class="productListSearchBar">
        @Html.TextBox("search", (string)ViewBag.Search, new
            {
                @class = "admin_searchbar", type = "search", autofocus = "", data_trim = "", placeholder = localizer["Search anime studios..."].Value}) 
                <img src = "/images/loader.gif" id = "loader" style = "display: none; vertical-align: middle; height: 30px;" />
    </div>

    <div class="search-container">
        <aside class="productListSidebar productListFilter">
                <div class="productListFilterContainer">
                    <h3>@localizer["Sort Studios"]</h3>
                    <div class="productListFilterGroup">
                        <label>
                            <input type="radio" name="sort" value="name_asc"
                            @(currentSort == "name_asc" ? "checked" : "") onchange="$('#f').submit()" /> @localizer["Name (A - Z)"]
                        </label>
                        <label>
                            <input type="radio" name="sort" value="name_desc"
                            @(currentSort == "name_desc" ? "checked" : "") onchange="$('#f').submit()" /> @localizer["Name (Z - A)"]
                        </label>
                        <label>
                            <input type="radio" name="sort" value="anime_count_desc"
                            @(currentSort == "anime_count_desc" ? "checked" : "") onchange="$('#f').submit()" /> @localizer["Most Animes"]
                        </label>
                        <label>
                            <input type="radio" name="sort" value="anime_count_asc"
                            @(currentSort == "anime_count_asc" ? "checked" : "") onchange="$('#f').submit()" /> @localizer["Least Animes"]
                        </label>
                        <label>
                            <input type="radio" name="sort" value="date_established"
                            @(currentSort == "date_established" ? "checked" : "") onchange="$('#f').submit()" /> @localizer["Date Established"]
                        </label>
                    </div>
                </div>

                <a asp-controller="Studio" asp-action="Index">@localizer["Clear All"]</a>
        </aside>

        <div class="productListContent" id="target">
            <partial name="_StudioGrid" model="Model" />
        </div>
    </div>
</form>

@section foot {

 <script>
    let timer = null;
        $('#search').on('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => $('#f').submit(), 500);
        });
</script>
}