@model StudioVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    Layout = "_AdminLayout";
    ViewBag.AdminStudios = "admin_sidenav-active";
}
<div class="admin_card">
    <h1>@localizer["Studio Details"]</h1>
    <div class="animedetail_wrapper">
        <div class="animedetail_images">
            <div class="studiodetail_thumbnail">
                <img src="/images/studio/@Model.ImageLink" />
            </div>
        </div>
        <div class="animedetail_info">
            <form class="addanime_form" method="post" asp-controller="Studio" asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="StudioID" />
                <div class="addanime_input-container">
                    <label class="addanime_label" asp-for="Name">@localizer["Name"]</label>
                    <input class="addanime_input-text" asp-for="Name" placeholder="Kyoto Animation" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="addanime_input-container">
                    <label class="addanime_label" asp-for="Description">@localizer["Description"]</label>
                    <textarea asp-for="Description" placeholder="@localizer["Enter Studio Description..."]" class="addanime_textarea"></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
                <div class="addanime_input-container">
                    <label class="addanime_label" asp-for="DateEstablished">@localizer["Date Established"]</label>
                    <input class="addanime_input-date" asp-for="DateEstablished" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateEstablished"></span>
                </div>
                <div class="addanime_input-container">
                    <label class="addanime_label" asp-for="StudioImage">@localizer["Studio Image"]</label>
                    <label class="addanime_photo-label">
                        <input class="addanime_photo-input studio_image" asp-for="StudioImage" accept="image/jpeg,image/png" hidden />
                        @localizer["Drag and drop images here."]
                    </label>
                    <div class="image-previews studio-previews"></div>
                    <span asp-validation-for="StudioImage"></span>
                </div>
                <div class="addanime_button-area">
                    <button class="addanime_button">@localizer["Edit Studio"]</button>
                    <button class="addanime_button" asp-controller="Studio" asp-action="ManagementDetails" asp-route-studioId="@Model.StudioID">@localizer["Reset"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="admin_card">
    <h1>@localizer["Animes Released"] (@(Model.Animes.Count > 0 ? Model.Animes.Count : 0))</h1>
    @if (Model.Animes.Count == 0)
    {
        <p>@localizer["There are no animes created by this studio in the database!"]</p>
    }
    else
    {
        <div class="studio_anime-grid">
            @foreach (var anime in Model.Animes)
            {
                <div class="studio_anime-item">
                    <a href="/Anime/ManagementDetails/?animeId=@anime.AnimeId">
                    @if(anime.AnimeImages.Count > 0)
                    {
                        <img class="studio_anime-img" src="/images/anime/@anime.AnimeImages.FirstOrDefault(i => i.IsThumbnail).ImageLink" />
                    }
                    else
                    {
                        <img class="studio_anime-img" src="/images/photo.jpg" />
                    }
                    </a>
                    <a href="/Anime/ManagementDetails/?animeId=@anime.AnimeId">@anime.Name</a>
                </div>
            }
        </div>
    }
</div>